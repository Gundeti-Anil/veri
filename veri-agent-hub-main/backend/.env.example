# ── Server ────────────────────────────────────────────────────────────────────
PORT=8787

# ── Sepolia RPC ───────────────────────────────────────────────────────────────
RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# ── VeriRegistrar — set after Deploy.s.sol ────────────────────────────────────
VERI_REGISTRAR_ADDRESS=0x...

# ── Attestor — backend signs EIP-712 Attestation(humanId, userAddress, deadline)
# The PUBLIC address of this key goes into VeriRegistrar constructor as _attestor.
# NEVER expose the private key to the client or commit it to git.
ATTESTOR_PRIVATE_KEY=0x...

# ── Subgraph Studio — set after graph deploy ──────────────────────────────────
SUBGRAPH_URL=https://api.studio.thegraph.com/query/YOUR_API_KEY/veri/version/latest

# ── World ID Selfie Check ──────────────────────────────────────────────────────
# From https://developer.world.org — request Selfie Check beta access on Day 1.
WORLD_APP_ID=app_...
WORLD_RP_ID=...
WORLD_SIGNING_KEY=0x...
WORLD_ACTION=register-agent

# See block comment in src/world.js verifyWorldProof() — set to true only if
# World's verify API is unreachable for your account tier (confirmed platform
# gap for Sandbox-simulated credentials as of this hackathon). Stubs ONLY the
# network call to World; nullifier replay + humanId + EIP-712 attestation
# still run for real. Leave false/unset for a real deployment.
WORLD_STUB_VERIFY=false

# ── Nullifier store (hackathon: JSON file; production: Postgres NUMERIC(78,0)) ─
NULLIFIERS_FILE=./nullifiers.json
